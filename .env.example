# Kopiere diese Datei nach .env und trage deine Werte ein.
# Die .env wird NICHT ins Git-Repo hochgeladen (steht in .gitignore).

ANTHROPIC_API_KEY=
DATABASE_URL=

# Passwort für den Login im Browser
APP_PASSWORD=

# Langer Zufallswert für Widgets, Cron-Job und Skripte.
# Erzeugen z. B. mit:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Langer Zufallswert, signiert die Login-Cookies (gleicher Befehl wie oben)
SECRET_KEY=

# Lokal über ngrok: https-Cookies erzwingen (bei reinem http://localhost auf 0 lassen)
COOKIE_SECURE=0

# Nur zum lokalen Entwickeln OHNE ngrok auf 1 setzen
FLASK_DEBUG=0

NGROK_DOMAIN=

PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
FINNHUB_API_KEY=
